#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set --key=php_upload_max_filesize --value=512M
ynh_app_setting_set --key=php_post_max_size --value=512M
ynh_app_setting_set --key=php_memory_limit --value=512M

#=================================================
# INSTALL COMPOSER
#=================================================
ynh_script_progression "Installing Composer..."

ynh_config_add --template="composer.json" --destination="$install_dir/composer.json"

ynh_composer_exec install --no-dev

#=================================================
# CREATE DRUSH ALIAS
#=================================================
ynh_script_progression "Creating Drush alias..."

install -d -m 750 -o $app -g $app "$install_dir/drush/sites/"
ynh_config_add --template="example.site.yml" --destination="$install_dir/drush/sites/self.site.yml"

#=================================================
# PREPARE DRUPAL CMS FOR THE BROWSER SETUP WIZARD
#=================================================
ynh_script_progression "Preparing Drupal CMS..."

update-alternatives --set php /usr/bin/php$php_version

# Drupal CMS is NOT installed here. Upstream's documented flow is a browser
# wizard (drupal_cms_installer): site name, site template, admin account.
# See https://project.pages.drupalcode.org/drupal_cms/get-started/setup/
#
# All we do is seed settings.php with the database credentials and a hash salt
# so the wizard can skip its database step and go straight to the site template
# choice. The site is installed the first time someone opens it in a browser.

install -d -m 770 -o $app -g www-data "$install_dir/tmp"
ynh_config_add --template=".htaccess" --destination="$install_dir/tmp/.htaccess"
chmod 0444 "$install_dir/tmp/.htaccess"

install -d -m 770 -o $app -g www-data "$install_dir/private"
ynh_config_add --template=".htaccess" --destination="$install_dir/private/.htaccess"
chmod 0444 "$install_dir/private/.htaccess"

install -d -m 775 -o $app -g www-data "$install_dir/web/sites/default/files"

hash_salt=$(ynh_string_random --length=74)
ynh_app_setting_set --key=hash_salt --value="$hash_salt"

cp "$install_dir/web/sites/default/default.settings.php" "$install_dir/web/sites/default/settings.php"

cat >> "$install_dir/web/sites/default/settings.php" <<EOF

/**
 * Settings written by the YunoHost package.
 */
\$databases['default']['default'] = [
  'driver' => 'mysql',
  'database' => '$db_name',
  'username' => '$db_user',
  'password' => '$db_pwd',
  'host' => 'localhost',
  'port' => '3306',
  'prefix' => '',
  // Since Drupal 9 the database drivers live inside modules. Without both
  // 'namespace' and 'autoload' the connection cannot be resolved at all, and
  // the installer silently falls back to its database form (offering sqlite,
  // which is too old on Debian for Drupal 11).
  'namespace' => 'Drupal\\\\mysql\\\\Driver\\\\Database\\\\mysql',
  'autoload' => 'core/modules/mysql/src/Driver/Database/mysql/',
];
\$settings['hash_salt'] = '$hash_salt';
\$settings['trusted_host_patterns'] = ['^${domain//./\\.}\$'];
\$settings['file_temp_path'] = '../tmp';
\$settings['file_private_path'] = '../private';
EOF

chown $app:www-data "$install_dir/web/sites/default/settings.php"
# The installer needs to be able to rewrite settings.php, and to create the
# services.yml it generates, so sites/default stays writable by the app user
# until the wizard has been completed. See ADMIN.md for how to lock it down.
chmod 0640 "$install_dir/web/sites/default/settings.php"
chmod 0750 "$install_dir/web/sites/default"

# Fail loudly here rather than handing the wizard a settings.php it cannot
# use: if the connection is broken the installer just re-asks for database
# credentials and defaults to sqlite.
pushd "$install_dir"
	if ! _ynh_exec_with_drush_php drush "@$app" sql:query "SELECT 1;" >/dev/null; then
		ynh_die "Could not connect to the database using the credentials written to settings.php"
	fi
popd

ynh_store_file_checksum "$install_dir/web/sites/default/settings.php"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a PHP-FPM config (with conf/extra_php-fpm.conf being appended to it)
ynh_config_add_phpfpm

# Create a dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

ynh_config_add --template="cron" --destination="/etc/cron.d/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed. Open https://$domain$path in a browser to run the Drupal CMS setup wizard."
