#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

# this will most likely adjust NGINX config correctly
_ynh_setup_webroot "$new_path"

ynh_config_change_url_nginx

#=================================================
# SPECIFIC MODIFICATIONS
#=================================================

# install and upgrade both write the alias as self.site.yml
ynh_config_add --template="example.site.yml" --destination="$install_dir/drush/sites/self.site.yml"
_ynh_set_trusted_host "$new_domain"

# The rendered page caches absolute URLs, so a stale cache would keep serving
# the old domain/path after the switch.
pushd "$install_dir"
	_ynh_exec_with_drush_php drush "@$app" cache:rebuild
popd

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
